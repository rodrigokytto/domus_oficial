graph TD
    subgraph Camada_1["1. Camada de Apresentação & Coleta de Vontade"]
        Touch["Assinatura Touch em Tela (Pointer/TouchEvents)<br/>Buffer Vetorial Bezier 60 FPS"]
        OTP["Autenticação em Duplo Fator (2FA)<br/>Tokens via WhatsApp & E-mail"]
        Biometria["Identificação de Dispositivo<br/>IP, User-Agent, Geolocalização GPS"]
    end

    subgraph Camada_2["2. Camada Criptográfica de Integridade"]
